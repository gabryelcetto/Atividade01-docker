# Copie este arquivo para ".env" antes de rodar "docker compose up".
# O ".env" real nunca é commitado (já está no .gitignore).

# ===== Banco de dados (MySQL) =====
# DB_HOST="db" -- nome do serviço no docker-compose.yml; o Docker resolve
# esse nome pra dentro da rede do projeto, não é preciso IP nem localhost.
DB_HOST=db
DB_PORT=3306
DB_NAME=controle_equipamentos
DB_USER=app_user
DB_PASSWORD=troque-esta-senha
# Senha do usuário root do container MySQL (usada só pela imagem oficial pra
# inicializar o banco na primeira subida; a aplicação não usa esta variável).
MYSQL_ROOT_PASSWORD=troque-esta-senha-root

# ===== Flask =====
SECRET_KEY=troque-esta-chave-em-producao
FLASK_DEBUG=0

# ===== Upload de fotos =====
# Enquanto as variáveis de S3 abaixo estiverem vazias, as fotos vão pro disco
# (static/uploads/, persistido pelo volume "uploads_data").
PASTA_UPLOADS=uploads/fotos

# ===== Fotos — object storage compatível com S3 (opcional) =====
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=auto
# S3_PUBLIC_BASE_URL=
